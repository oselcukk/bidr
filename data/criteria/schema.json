{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YÖKAK/BİDR ölçüt şeması",
  "type": "object",
  "required": ["meta", "areas", "criteria", "sub_criteria"],
  "additionalProperties": false,
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "textList": {"type": "array", "items": {"$ref": "#/$defs/text"}}
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schema_version", "source_form", "source_sha256", "counts"],
      "properties": {
        "schema_version": {"const": 1},
        "framework": {"type": "string"},
        "source_form": {"type": "string"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "extracted_by": {"type": "string"},
        "text_policy": {"type": "string"},
        "counts": {
          "type": "object",
          "required": ["areas", "criteria", "sub_criteria"],
          "properties": {
            "areas": {"type": "integer", "minimum": 0},
            "criteria": {"type": "integer", "minimum": 0},
            "sub_criteria": {"type": "integer", "minimum": 0}
          }
        },
        "notes": {"type": "array", "items": {"type": "string"}},
        "redactions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "kind", "to", "ids"],
            "properties": {
              "field": {"type": "string"},
              "kind": {"type": "string"},
              "to": {"type": "string"},
              "ids": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-D]$"},
          "title": {"$ref": "#/$defs/text"},
          "description": {"$ref": "#/$defs/textList"}
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "parent", "description"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-D]\\.[0-9]+$"},
          "title": {"$ref": "#/$defs/text"},
          "parent": {"type": "string", "pattern": "^[A-D]$"},
          "description": {"$ref": "#/$defs/textList"}
        }
      }
    },
    "sub_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "parent", "description", "units", "rubric", "example_evidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-D]\\.[0-9]+\\.[0-9]+$"},
          "title": {"$ref": "#/$defs/text"},
          "parent": {"type": "string", "pattern": "^[A-D]\\.[0-9]+$"},
          "description": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
          "units": {"$ref": "#/$defs/text"},
          "units_note": {"$ref": "#/$defs/textList"},
          "rubric": {
            "type": "object",
            "required": ["1", "2", "3", "4", "5"],
            "additionalProperties": false,
            "patternProperties": {"^[1-5]$": {"$ref": "#/$defs/text"}}
          },
          "example_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
        }
      }
    }
  }
}
