{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verify_yonler",
  "type": "object",
  "required": ["maddeler", "genel"],
  "additionalProperties": false,
  "properties": {
    "maddeler": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["yer", "karar", "gerekce"],
        "additionalProperties": false,
        "properties": {
          "yer": {"type": "string", "pattern": "^[ga][0-9]+$"},
          "karar": {"enum": ["destekleniyor", "kismen", "desteklenmiyor"]},
          "gerekce": {"type": "string", "minLength": 1, "maxLength": 600}
        }
      }
    },
    "genel": {"type": "string", "maxLength": 1000}
  }
}
