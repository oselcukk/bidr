{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "name_evidence",
  "type": "object",
  "required": ["kanit_adi", "gerekce"],
  "additionalProperties": false,
  "properties": {
    "kanit_adi": {"type": "string", "minLength": 3, "maxLength": 80},
    "parca_adlari": {
      "type": "object",
      "maxProperties": 6,
      "propertyNames": {"pattern": "^[A-Z](\\.[0-9]+)+/[0-9]+$"},
      "additionalProperties": {"type": "string", "minLength": 3, "maxLength": 80}
    },
    "gerekce": {"type": "string", "maxLength": 300}
  }
}
