{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "classify_fine",
  "type": "object",
  "required": ["karar", "birim_iliskisi", "kanit_adi", "eslesmeler", "gerekce"],
  "additionalProperties": false,
  "properties": {
    "karar": {"enum": ["olcut_var", "olcut_yok", "kanit_degil"]},
    "birim_iliskisi": {"enum": ["kendi", "ust_birim_bu_birim_hakkinda", "fakulte_geneli", "kurum_geneli", "baska_birim", "belirsiz"]},
    "kanit_adi": {"type": "string", "minLength": 3, "maxLength": 80},
    "eslesmeler": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["olcut", "yuva", "asama", "od_onerisi", "alinti", "gerekce", "guven"],
        "additionalProperties": false,
        "properties": {
          "olcut": {"type": "string", "pattern": "^[A-E]\\.[0-9]+\\.[0-9]+$"},
          "yuva": {"type": "string", "pattern": "^[A-E]\\.[0-9]+\\.[0-9]+/[0-9]+$"},
          "asama": {"enum": ["planla", "uygula", "kontrol_et", "onlem_al", "ozgun"]},
          "od_onerisi": {"type": "integer", "minimum": 2, "maximum": 5},
          "alinti": {"type": "string", "minLength": 1, "maxLength": 600},
          "gerekce": {"type": "string", "minLength": 1},
          "guven": {"enum": ["yuksek", "orta", "dusuk"]}
        }
      }
    },
    "gerekce": {"type": "string"}
  }
}
