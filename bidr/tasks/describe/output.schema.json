{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "gorseller": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "gorsel": {"type": "integer", "minimum": 1},
          "icerik": {"enum": ["fotograf", "afis", "ekran_goruntusu", "grafik_sema", "belge_sayfasi", "diger"]},
          "sahne": {"type": "string", "maxLength": 160},
          "etkinlik": {"type": "string", "maxLength": 160},
          "kalabalik": {"enum": ["yok", "1-5", "6-20", "21-50", "51-200", "200+", "belirsiz"]},
          "nesneler": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "ad": {"type": "string", "minLength": 1, "maxLength": 80},
                "yaklasik_sayi": {"type": ["integer", "null"], "minimum": 0}
              },
              "required": ["ad", "yaklasik_sayi"],
              "additionalProperties": false
            }
          },
          "gorunen_yazilar": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "properties": {
                "yer": {"enum": ["tabela", "afis", "pankart", "ekran", "etiket", "plaket", "belge", "diger"]},
                "metin": {"type": "string", "minLength": 1, "maxLength": 1500}
              },
              "required": ["yer", "metin"],
              "additionalProperties": false
            }
          },
          "betimleme": {"type": "string", "minLength": 1, "maxLength": 800}
        },
        "required": ["gorsel", "icerik", "sahne", "etkinlik", "kalabalik", "nesneler", "gorunen_yazilar", "betimleme"],
        "additionalProperties": false
      }
    },
    "notlar": {"type": "string"}
  },
  "required": ["gorseller"],
  "additionalProperties": false
}
